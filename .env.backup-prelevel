APP_NAME=Growza
APP_ENV=local
APP_KEY=base64:DhdfZJFMjdVBcBSKWWTx3bD5O1Qazo08/SdFKTlskOo=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_LOCALE=en

# Never index dashboard/admin routes; only marketing pages are indexable (see LEVEL 31)
APP_ALLOW_INDEXING=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# PostgreSQL is the preferred driver. MySQL is supported for compatibility.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=growza
DB_USERNAME=growza
DB_PASSWORD=growza_local_password

# --- Session / Cache / Queue -------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Separate logical DBs so cache/queue/session never collide (see ARCHITECTURE.md §Redis)
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@growza.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS (architecture only at v1.0 — see LEVEL 12) --------------------------
SMS_DRIVER=log

# --- Payments ------------------------------------------------------------------
# Never commit real values. Populate only in the untracked local/production .env.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Default gateway offered at checkout when the user has no prior preference
DEFAULT_PAYMENT_GATEWAY=paystack

# --- Providers (LEVEL 10) -----------------------------------------------------
# Concrete provider credentials are added per-provider via the admin Providers
# module (encrypted at rest) — NOT hard-coded here. This section intentionally
# has no named third-party provider, per the open decision in the architecture spec.
PROVIDER_DEFAULT_ADAPTER=mock
PROVIDER_HEALTH_CHECK_INTERVAL_MINUTES=5

# --- Auth / Security -----------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=null
TWO_FACTOR_ENABLED_BY_DEFAULT=false
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_DECAY_SECONDS=60

# --- Filesystem / Object storage (see ARCHITECTURE.md §18 open decision) -------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
